{
  "name": "@local/dsh-hifleet-tools",
  "version": "2.1.1",
  "private": true,
  "description": "DeepSeek Harness (DSH) bundle for HiFleet Tools (unofficial): bundles the zero-dependency Node MCP server and connects it over stdio, exposing its tools as mcp__hifleet__*.",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "mcp",
    "hifleet",
    "vessel",
    "maritime",
    "port",
    "route"
  ],
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "cordis.patch.yml",
    "index.js",
    "client.js",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "PROVENANCE.md",
    ".env.example",
    ".gitignore",
    "login.cmd",
    "server",
    "shared",
    "skills"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "license": "UNLICENSED"
}
