      },
      "report_query": {
        "method": "POST",
        "path": "/publicapi/vesselreport/query",
        "body": "form",
        "defaults": { "order": "desc", "offset": 0, "limit": 5 }
      },
      "report_types": {
        "method": "POST",
        "path": "/publicapi/vesselreport/list/types",
        "body": "form"
      },
      "report_delete": {
        "method": "POST",
        "path": "/publicapi/vesselreport/delete",
        "body": "form",
        "write": true
      }
