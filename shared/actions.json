      },
      "add": {
        "method": "POST",
        "path": "/hifleetapi/addFleet2MultiGroup.do",
        "body": "form",
        "write": true
      },
      "remove": {
        "method": "POST",
        "path": "/hifleetapi/deleteFleetAndGroup.do",
        "body": "form",
        "defaults": { "id": 2 },
        "write": true
      },
      "login_status": {
        "method": "GET",
        "path": "/hifleetapi/loginstatus.do",
        "body": "query"
      },
      "logout": {
        "method": "POST",
        "path": "/hifleetapi/userLogOut.do",
